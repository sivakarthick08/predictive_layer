NODE_ENV=production

OPENAI_API_KEY="your-openai-api-key-here"

PORT=4111

E2B_API_KEY="your-e2b-api-key-here"

# PostgreSQL Configuration (Priority data source)
DATABASE_URL="your-postgresql-connection-string-here"
DATABASE_TABLE="your-database-table-name-here"

# Optional: JSON file data source (used only if DATABASE_URL not set)
DATA_FILE="your-global-path-to-data.json-here"